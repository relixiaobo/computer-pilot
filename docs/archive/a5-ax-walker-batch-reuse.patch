+/// `walk` receives ownership from its parent and has early returns (element
+/// limit reached, depth cap) that fire *before* the array would otherwise be
+/// released. A guard keeps every exit path correct, per the CFRelease rule in
+/// CLAUDE.md ("all AXUIElementCopyAttributeValue results are +1 retained").
+struct BatchValues(CFArrayRef);
+
+impl Drop for BatchValues {
+    fn drop(&mut self) {
+        if !self.0.is_null() {
+            unsafe { CFRelease(self.0) };
+        }
+    }
+}
