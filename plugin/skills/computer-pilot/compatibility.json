{
  "schema_version": 2,
  "version": "0.9.5",
  "integration_model": "skill-shell-cli",
  "cli": {
    "name": "cu",
    "version": "0.9.5",
    "tested_version": "0.9.5",
    "minimum_version": "0.9.5",
    "machine_schema_version": "1.0"
  },
  "private_broker_protocol": 8,
  "platforms": [
    "macos-arm64"
  ],
  "unsupported_platforms": [
    "macos-x86_64"
  ],
  "installation": {
    "repository": "relixiaobo/computer-pilot",
    "asset_template": "computer-pilot-v{version}-macos-arm64.tar.gz",
    "installer": "scripts/install-native.sh",
    "install_root": "${XDG_DATA_HOME:-$HOME/.local/share}/computer-pilot",
    "command_path": "${XDG_DATA_HOME:-$HOME/.local/share}/computer-pilot/bin/cu",
    "signing": {
      "identifier": "com.linlab.computer-pilot.cu",
      "requirement": "identifier \"com.linlab.computer-pilot.cu\" and anchor apple generic and certificate 1[field.1.2.840.113635.100.6.2.6] exists and certificate leaf[field.1.2.840.113635.100.6.1.13] exists and certificate leaf[subject.OU] = \"5NQ98WCWPD\"",
      "required_status": "developer-id-notarized"
    }
  },
  "requires": {
    "shell": true,
    "mcp": false,
    "stdio_bridge": false,
    "native_sdk": false
  }
}
